@inherits LayoutComponentBase

<div class="page">

    <div class="text-center navbar-container welcome-head-content">
        <h1 class="p-2">Welcome to 
            <span style="color: #ffcc33; text-transform: uppercase">Bite<span style="color: #fff;">Zone</span></span>
        </h1>
    </div>

    <main>
        <article class="content">
            @Body
        </article>
    </main>

    <Footer />
</div>

<style>
    :root {
        --bite-purple: #3c3f6a;
        --bite-purple-dark: #2d2f50;
        --bite-yellow: #ffcc33;
        --bite-red: #ff4747;
        --bite-white: #ffffff;
        --nav-height: 80px;

    }

    .navbar-container {
        min-height: 100px;
        background-color: var(--bite-purple);
        border-bottom: 3px solid var(--bite-yellow);
        font-family: Helvetica;
    }

    .welcome-head-content h1{
        color: var(--bite-white);
        font-size: 3.5rem;
        font-weight: 900;
        margin: 0;
    }

    .nav-brand {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: var(--nav-height);
        padding: 0 1.5rem;
        background-color: var(--bite-purple);
        z-index: 101;
    }

    .nav-brand a {
        display: flex;
        align-items: center;
        text-decoration: none;
        gap: 10px;
    }

    .logo-img {
        height: 50px;
        width: 50px;
    }

    .brand-text {
        font-size: 1.5rem;
        font-weight: 900;
        color: #fff;
        letter-spacing: -1px;
    }

    .brand-text span {
        color: var(--bite-yellow);
    }

    .mobile-toggle {
        background: var(--bite-purple-dark);
        border: 1px solid var(--bite-yellow);
        color: var(--bite-yellow);
        font-size: 1.5rem;
        padding: 5px 12px;
        border-radius: 5px;
        cursor: pointer;
        display: block;
    }

    /* MOBILE MENU LOGIC */
    .nav-content {
        background-color: var(--bite-purple-dark);
        display: none;
        /* Hidden by default */
        flex-direction: column;
    }

    .nav-content.show-menu {
        display: flex !important;
        /* Visible when button is clicked */
    }

    .nav-block {
        display: flex;
        align-items: center;
        padding: 1.2rem 1.5rem;
        color: white;
        text-decoration: none;
        font-weight: 700;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        gap: 15px;
    }

    .nav-block i {
        color: var(--bite-yellow);
        font-size: 1.2rem;
    }

    .cart-wrapper {
        position: relative;
    }

    .cart-badge {
        position: absolute;
        top: -8px;
        right: -10px;
        background: var(--bite-red);
        font-size: 0.7rem;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

    /* DESKTOP RE-STYLES */
    @@media (min-width: 992px) {
        .navbar-container {
            flex-direction: row;
            height: var(--nav-height);
            align-items: stretch;
        }

        .mobile-toggle {
            display: none;
        }

        .nav-content {
            display: flex !important;
            flex-direction: row;
            background-color: transparent;
            flex-grow: 1;
            justify-content: space-between;
        }

        .main-nav,
        .nav-right {
            display: flex;
            flex-direction: row;
            align-items: stretch;
        }

        .nav-block {
            flex-direction: column;
            justify-content: center;
            padding: 0 25px;
            border-bottom: none;
            border-left: 1px solid rgba(255, 255, 255, 0.1);
            min-width: 100px;
            gap: 5px;
            font-size: 0.75rem;
        }

        .nav-block:hover {
            background-color: var(--bite-purple-dark);
            color: var(--bite-yellow);
        }

        .cart-block {
            background-color: var(--bite-purple-dark);
        }
    }
</style>